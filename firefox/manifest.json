{
  "manifest_version": 2,
  "name": "SLCM Feedback Filler",
  "version": "2.0.0",
  "description": "Rating-based comment helper for the SLCM feedback form.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "applications": {
    "gecko": {
      "id": "yourname@example.com",
      "strict_min_version": "109.0"
    }
  }
}